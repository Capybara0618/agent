        {
          "sha": "556f6a5514bba73ae39db2d08978ff9860ff6151",
          "html_url": "https://github.com/robotframework/robotframework/commit/556f6a5514bba73ae39db2d08978ff9860ff6151",
          "message": "Simplify executing user keywords.\n\nMost importantly, remove `UserLibrary`, `UserKeywordHandler` and\n`EmbeddedArgumentsHandler` in favor of using `ResourceFile` and\n`UserKeyword` directly. This required enhancing `UserKeyword` so that\nit handles possible embedded arguments. Parsing was also enhanced ",
          "author": "Pekka Klärck",
          "date": "2023-11-30T12:21:44Z"
        },
        {
          "sha": "9bef6e9fd313f62c0d772de60690af39bee9fa43",
          "html_url": "https://github.com/robotframework/robotframework/commit/9bef6e9fd313f62c0d772de60690af39bee9fa43",
          "message": "Refactor building user keywords.\n\n- Change parsing embedded arguments to `UserKeyword`.\n- Move validating `UserKeyword` to runner.\n- Don't report user keywords being empty to console. We want listeners\n  to be able to update them.\n\nMain motivation is making it possible to remove separate\n`UserKeywor",
          "author": "Pekka Klärck",
          "date": "2023-11-29T18:38:29Z"
        },
        {
          "sha": "9be8ac14692b6f46de8d17ad04cbd906cfd38006",
          "html_url": "https://github.com/robotframework/robotframework/commit/9be8ac14692b6f46de8d17ad04cbd906cfd38006",
          "message": "Start merging UserKeyword and UserKeywordHandler.\n\nGive UserKeyword all attributes that UserKeywordHandler has and also\nchange `args` to be an ArgumentSpec instead of just a tuple. The\nmotivation is removing UserKeywordHandler is altogether.",
          "author": "Pekka Klärck",
          "date": "2023-11-29T09:03:02Z"
        },
        {
          "sha": "3510aa9f2f6754aaaf4bf8de1fd3c1b4309ac2ca",
          "html_url": "https://github.com/robotframework/robotframework/commit/3510aa9f2f6754aaaf4bf8de1fd3c1b4309ac2ca",
          "message": "Transfrom `[Return]` to `RETURN` in parsing.\n\nThis allows removing everything `[Return]` related from the execution\nside. `[Return]` is still deprecated (#4876), but now that it exists\nonly in the parsing model there's no urgent need to remove it fully.",
          "author": "Pekka Klärck",
          "date": "2023-11-10T11:42:33Z"
        },
        {
          "sha": "cd22336b77f1345a3f85f0ccad3eef2f1b26cd16",
          "html_url": "https://github.com/robotframework/robotframework/commit/cd22336b77f1345a3f85f0ccad3eef2f1b26cd16",
          "message": "Support `[Setup]` with keywords. Fixes #4747.",
          "author": "Pekka Klärck",
          "date": "2023-10-10T12:37:15Z"
        }
      ]
