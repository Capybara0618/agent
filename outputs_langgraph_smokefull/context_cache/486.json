        },
        {
          "sha": "1ee8336acae370bb7e5444acae11752227e726d1",
          "html_url": "https://github.com/koordinates/kart/commit/1ee8336acae370bb7e5444acae11752227e726d1",
          "message": "import: Fix very large --replace-ids imports\n\nIf you pass millions of IDs to --replace-ids (via a file!),\nit tends to crash postgres because of an enormous IN clause.\n\nThis commit splits it up into manageable chunks of 10000 IDs per query",
