    "original_code": "def parse_trade(self, trade, market=None):\n    timestamp = None\n    if 'Timestamp' in trade:\n        timestamp = trade['Timestamp'] * 1000\n    elif 'TimeStamp' in trade:\n        timestamp = self.parse8601(trade['TimeStamp'])\n    price = None\n    cost = None\n    if 'Price' in trade:\n        price = trade['Price']\n    elif 'Rate' in trade:\n        price = trade['Rate']\n    # todo fee parsing\n    fee = None\n    return {\n        'id': None,\n        'info': trade,\n        'timestamp': timestamp,\n        'datetime': self.iso8601(timestamp),\n        'symbol': market['symbol'],\n        'type': None,\n        'side': trade['Type'].lower(),\n        'price': price,\n        'cost': cost,\n        'amount': trade['Amount'],\n        'fee': fee,\n    }",
